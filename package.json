{
  "name": "lumio",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "packageManager": "bun@1.4.4",
  "engines": { "bun": ">=1.4.4 <1.5" },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.client.json",
    "test": "bun test --timeout 30000",
    "lint:deps": "depcruise packages apps --config .dependency-cruiser.cjs",
    "schema:export": "bun run packages/schema/scripts/export-json-schema.ts",
    "check": "bun run typecheck && bun run lint:deps && bun test --timeout 30000",
    "gen:skill": "bun run scripts/gen-skill.ts",
    "demo:web": "bun run scripts/web-demo.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "dependency-cruiser": "^16.0.0",
    "typescript": "^5.6.0"
  }
}
